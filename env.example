# Copy this file to ".env" and fill in your own key:
#     cp .env.example .env        (Mac/Linux)
#     copy .env.example .env      (Windows)
# NEVER commit the real ".env" file. It is already listed in .gitignore.

# Your Anthropic API key (get one from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-api-key-here

# Which Claude model to use for answers, summaries, quizzes and flashcards
LLM_MODEL=claude-sonnet-5-5

# ---- Optional settings (the defaults are fine for most people) ----
# MAX_UPLOAD_MB=25
# MAX_PAGES=500
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# TOP_K=4
# LLM_MAX_TOKENS=2000
# STUDY_DB_PATH=data/study_assistant.db
